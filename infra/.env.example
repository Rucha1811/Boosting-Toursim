# Virsa - environment configuration
# Copy to .env and adjust. NEVER commit the real .env file.

# --- Database ---
# Local (SQLite, zero setup):
DATABASE_URL=sqlite:///./virsa.db
# Docker / production (Postgres):
# DATABASE_URL=postgresql+psycopg://virsa:CHANGE_ME@postgres:5432/virsa
POSTGRES_USER=virsa
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=virsa

# --- Auth ---
# Generate a real one for production:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- App ---
# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8080
# Set false on a real deployment so the demo seed does not overwrite data.
SEED_ON_STARTUP=true
# Keep true for the hackathon demo; set false to use real data.
DEMO_MODE=true

# --- Frontend build ---
# Public URL of the backend, baked in at build time.
VITE_API_TARGET=/api

# NOTE: Docker Compose loads this file automatically when it sits next to
# docker-compose.yml, and substitutes the ${VAR} references in that file.
# Keep POSTGRES_PASSWORD URL-safe (letters/digits only) - it is embedded in
# the DATABASE_URL connection string.
